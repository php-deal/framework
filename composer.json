{
    "name": "php-deal/framework",
    "description": "AI Design by Contract for PHP: AI agents turn business specifications into code with preconditions, postconditions and invariants, checked on every call",
    "type": "library",
    "keywords": [
        "dbc",
        "design-by-contract",
        "contract",
        "precondition",
        "postcondition",
        "invariant",
        "attributes",
        "aop",
        "goaop",
        "ai",
        "ai-agents",
        "agent-skills",
        "claude-code",
        "specification",
        "contract-based-testing"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Lisachenko",
            "email": "lisachenko.it@gmail.com"
        },
        {
            "name": "Piotr Dawidiuk",
            "email": "piotr.dawidiuk@gmail.com"
        },
        {
            "name": "Andreas Frömer",
            "email": "blubb0r05+github@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "goaop/framework": "^4.0"
    },
    "require-dev": {
        "beberlei/assert": "^3.3.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "beberlei/assert": "Thin assertion library that can be used inside contract expressions"
    },
    "autoload": {
        "psr-4": {
            "PhpDeal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Demo\\": "demo/",
            "Example\\Inventory\\": "skills/design-by-contract/examples/inventory/",
            "PhpDeal\\Tests\\": "tests/"
        },
        "classmap": [
            "skills/design-by-contract/scripts/"
        ]
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpunit": "phpunit",
        "demo": "php demo/run.php",
        "test": [
            "@cs",
            "@phpstan",
            "@phpunit"
        ]
    },
    "scripts-descriptions": {
        "cs": "Check the coding style",
        "cs:fix": "Fix the coding style",
        "phpstan": "Run static analysis (PHPStan level 10)",
        "phpunit": "Run the test suite",
        "demo": "Run the demo application",
        "test": "Run every quality check"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/php-deal/framework/issues",
        "source": "https://github.com/php-deal/framework",
        "docs": "https://github.com/php-deal/framework/blob/master/README.md"
    }
}
