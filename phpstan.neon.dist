includes:
    - extension.neon

parameters:
    level: 10
    phpVersion:
        min: 80400
        max: 80599
    paths:
        - src
        - tests
        - demo
        - skills
    excludePaths:
        - tests/cache (?)
        - demo/cache (?)
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
